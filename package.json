{
  "name": "task-management-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "coverage": "nyc npm test && nyc report --reporter=text-lcov | coveralls",
    "dev": "nodemon src/server.ts",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo",
    "migrate:undo:all": "sequelize db:migrate:undo:all"
  },
    "nyc": {
    "extension": [".ts", ".js"],
    "include": ["src/**/*.ts"],
    "exclude": ["**/*.d.ts", "tests/**", "node_modules/**"],
    "reporter": ["lcov", "text-summary"],
    "all": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-Rwanda/Task-management-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Martin-Rwanda/Task-management-backend/issues"
  },
  "homepage": "https://github.com/Martin-Rwanda/Task-management-backend#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "coveralls": "^3.1.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "nyc": "^17.1.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^4.8.4"
  }
}
